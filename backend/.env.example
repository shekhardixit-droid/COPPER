# Backend environment variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# Port the Express server listens on inside the container
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# The public-facing URL of the frontend (used for CORS allow-list)
# Example: http://your-vps-ip:3000  or  https://yourdomain.com
FRONTEND_URL=http://your-vps-ip:3000
