# ── Frontend ──────────────────────────────────────────────────
# Host port used to access the frontend
FRONTEND_PORT=3000

# Public backend URL used by the frontend
# Example: http://YOUR_VPS_IP:5000/
VITE_API_URL=

# ── Backend ───────────────────────────────────────────────────
# Host port used by the backend API
BACKEND_PORT=5000

# MongoDB Atlas connection string
# Put the real value only in .env / Hostinger environment variables
MONGODB_URI=

# Public frontend URL used for CORS
# Example: http://YOUR_VPS_IP:3000
FRONTEND_URL=