# Root docker-compose environment variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# ── Frontend ──────────────────────────────────────────────────
# Host port the frontend (nginx) is exposed on
FRONTEND_PORT=3000

# Public-facing backend URL the browser uses to call the API
# Must end with /
# Use your VPS public IP or domain
VITE_API_URL=http://your-vps-ip:5000/

# ── Backend ───────────────────────────────────────────────────
# Host port to optionally expose the backend (uncomment ports in compose)
BACKEND_PORT=5000

# MongoDB Atlas connection string (keep secret)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Public-facing frontend URL for CORS (must match FRONTEND_PORT)
FRONTEND_URL=http://your-vps-ip:3000
