# ── Frontend ──────────────────────────────────────────────────
# Host port used to access the frontend
FRONTEND_PORT=3000

# Public backend URL used by the browser to call the API (must end with /)
VITE_API_URL=http://200.234.34.214:5002/

# ── Backend ───────────────────────────────────────────────────
# Host ports 5000 and 5001 are occupied on this VPS — using 5002
BACKEND_PORT=5002

# MongoDB Atlas connection string
# Put the real value only in .env / Hostinger environment variables
MONGODB_URI=

# Public frontend URL used for CORS
FRONTEND_URL=http://200.234.34.214:3000
