# Frontend environment variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# NOTE: VITE_ variables are baked into the JS bundle at build time.
# If you change this value you must rebuild the Docker image.

# The public-facing URL of the backend API (must end with /)
# Example: http://your-vps-ip:5000/  or  https://api.yourdomain.com/
VITE_API_URL=http://your-vps-ip:5000/
